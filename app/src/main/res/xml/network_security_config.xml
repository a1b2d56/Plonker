<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Permits cleartext HTTP for local LAN endpoints (local WebDAV, SMB, DLNA, Navidrome)
      while maintaining security standards expected by platform verifiers and security scans.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
